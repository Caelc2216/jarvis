# Copy this file to .env and fill in what you use. Never share .env.

# Default brain (you can always say "ask Claude ..." or "ask ChatGPT ..." for one question):
#   ollama      free local model on your GPU, fastest (2-5 s)
#   claude      your Claude Pro plan via Claude Code (5-10 s, smartest, has web search)
#   codex       your ChatGPT plan via Codex (10-25 s)
#   claude-api  / openai   pay-per-use API keys below
BRAIN=ollama
# OLLAMA_MODEL=qwen3:8b       (qwen3:14b is smarter but slower)
# CLAUDE_CODE_MODEL=sonnet    (or haiku for speed, opus for depth)
# Code mode ("let's code on <project>") uses Claude Code, or Codex if your brain is ChatGPT/Codex.
# CODER=claude                (or codex; Codex only runs inside its safety sandbox)
# CODER_LIVE_WINDOW=on        (the live view window opens when code mode starts)
# CODEX_MODEL=                (blank = your plan's default)

# Claude API key, only for BRAIN=claude-api (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# ChatGPT (https://platform.openai.com). Also used for better speech-to-text.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Jarvis voice from ElevenLabs (also used to understand your speech).
# Leave blank to use the backup voice below.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Backup voice (Kokoro): free, runs on this PC, used when there's no ElevenLabs key, the credits
# run out, or ElevenLabs is down. Downloads about 115 MB once. BACKUP_VOICE=windows turns it off.
# Voices: bm_george, bm_lewis, bm_daniel, bm_fable (British men), bf_emma, bf_isabella, bf_alice,
# bf_lily (British women).
# BACKUP_VOICE=kokoro
# KOKORO_VOICE=bm_george
# KOKORO_SPEED=1.0

# Feit/Tuya lights: from your Tuya cloud project's Overview page. Then run: python jarvis.py lights
# Region: us = Western America data center
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=us

# Clapping twice to wake Jarvis: off by default ("Hey Jarvis" only). Set to on to allow it too.
WAKE_CLAP=off
# "Hey Jarvis" wake word. Raise WAKE_FRAMES if it wakes by
# accident, lower it (min 2) if it misses you.
WAKE_WORD=on
# WAKE_THRESHOLD=0.5
# WAKE_FRAMES=4

# On-screen display. HUD_MONITOR: left | main | right. HUD_AREA: bottom-right | top-right |
# bottom-left | top-left | full (full = the big HUD, maximized). HUD_SIZE is used for corners;
# 900 px or wider shows the full layout.
HUD=on
HUD_MONITOR=right
HUD_AREA=bottom-right
HUD_SIZE=420x640
HUD_ON_TOP=on
# Hide the HUD while Jarvis waits for "Hey Jarvis"; it pops up when you wake it.
HUD_AUTOHIDE=on

# Laptop / slower PC? PERFORMANCE=lite checks things less often and turns off the on-screen display
# (LITE_HUD=on keeps it). The biggest speed-up on a laptop is a cloud brain (BRAIN=claude or codex).
PERFORMANCE=

# Which microphone to use (part of its name). Blank = Windows' default. "Test microphone.bat" sets it.
MIC_DEVICE=
# How much to turn up a quiet microphone for "Hey Jarvis" (e.g. 3). Blank = Jarvis learns it from your voice.
MIC_GAIN=

# Text Jarvis from your phone through a private Discord bot. Easiest: run "Set up Discord.bat".
# Only DISCORD_OWNER_ID can control it; everyone else is ignored. Keep the token secret.
REMOTE=on
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=

# What opens when Jarvis first wakes up (names from APPS in tools.py), and what it says.
WELCOME_ACTIONS=apple music
WELCOME_LINE=Welcome back, sir. All systems are online.
